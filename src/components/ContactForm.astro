---
import settings from "../content/settings/site.json";
// Posts straight to Formspree; browser validation only, no script.
// _gotcha is Formspree's honeypot: bots that fill it are silently dropped.
// After sending, visitors see Formspree's own thank-you page.
---

<form class="contact-form" action={settings.contactFormAction} method="post">
  <fieldset>
    <legend>Name *</legend>
    <div class="pair">
      <label>
        First name
        <input class="field" type="text" name="first_name" autocomplete="given-name" required />
      </label>
      <label>
        Last name
        <input class="field" type="text" name="last_name" autocomplete="family-name" required />
      </label>
    </div>
  </fieldset>
  <label>
    Email *
    <input class="field" type="email" name="email" autocomplete="email" required />
  </label>
  <label>
    Subject
    <input class="field" name="subject" />
  </label>
  <label>
    Your message *
    <textarea class="field" name="message" rows="7" required></textarea>
  </label>
  <div class="trap" aria-hidden="true">
    <label>
      Leave this field empty
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <button class="btn" type="submit">Send message</button>
</form>

<style>
  .contact-form {
    padding: clamp(24px, 4vw, 40px);
    background: var(--sand);
    border-radius: 8px;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend,
  label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  legend {
    margin-bottom: 8px;
  }
  label {
    display: block;
    margin-bottom: 20px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pair label {
    font-weight: 400;
  }
  .field {
    margin-top: 8px;
    font-weight: 400;
  }
  textarea.field {
    resize: vertical;
  }
  .trap {
    position: absolute;
    left: -5000px;
  }
  @media (max-width: 520px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
