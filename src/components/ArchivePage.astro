---
import Base from "../layouts/Base.astro";
import PageIntro from "./PageIntro.astro";
import CategoryNav from "./CategoryNav.astro";
import PostGrid from "./PostGrid.astro";

// Category and tag archives at their original WordPress URLs.
interface Props {
  label: "Category" | "Tag";
  term: { name: string; slug: string; posts: any[] };
}
const { label, term } = Astro.props;
const count = `${term.posts.length} ${term.posts.length === 1 ? "article" : "articles"}`;
// The "Blog" category would share the /blog/ page's title.
const title = term.slug === "blog" ? "Blog category" : term.name;
---

<Base
  title={title}
  description={`${count} on ${term.name} by Dr. Rhea Mehta, scientist and holistic health coach, on Living Rhea.`}
>
  <PageIntro
    eyebrow={label}
    title={term.name}
    lead={count}
  />
  <div class="wrap archive-list">
    {label === "Category" && <CategoryNav current={term.slug} />}
    <PostGrid posts={term.posts} />
  </div>
</Base>

<style>
  .archive-list {
    padding-bottom: var(--section);
  }
</style>
