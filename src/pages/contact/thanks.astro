---
import Base from "../../layouts/Base.astro";
// Formspree redirects here after a successful contact message (set in the
// form's Formspree settings). Not in the sitemap; kept out of search.
---

<Base title="Message sent" description="Thank you for your message. Rhea will get back to you soon." noindex>
  <section class="section narrow center">
    <span class="eyebrow">Contact</span>
    <h1 class="display">Message sent</h1>
    <p class="lead">Thank you for reaching out. Rhea will get back to you soon.</p>
    <div class="actions" style="justify-content:center">
      <a class="btn" href="/">Go to the homepage</a>
      <a class="btn ghost" href="/blog/">Browse the blog</a>
    </div>
  </section>
</Base>
